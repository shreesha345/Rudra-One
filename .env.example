# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rudraone
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rudraone

# Deepgram API (for speech-to-text)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Twilio Configuration (for phone calls)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# Google Gemini API (for AI responses)
GEMINI_API_KEY=your_gemini_api_key_here

# Sarvam AI (for Text-to-Speech in Indian languages)
SARVAM_API_KEY=your_sarvam_api_key_here

# Mapbox (for maps and geocoding)
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# Application Settings
VITE_API_URL=http://localhost:8000
