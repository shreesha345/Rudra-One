# ════════════════════════════════════════════════════════════════════════════
# RudraOne — Universal Environment Configuration
# This single .env file is read by BOTH the backend (Python) and the
# frontend (Vite).  Vite only picks up variables prefixed with VITE_.
# ════════════════════════════════════════════════════════════════════════════

# ── General ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development
PORT=8000
ALLOWED_ORIGINS=*
# ALLOWED_HOSTS=example.com,api.example.com

# ── Default login (seeded on first DB run) ───────────────────────────────────
DEFAULT_USERNAME=Shreesha
DEFAULT_PASSWORD=Shreesha123admin

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rudraone
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rudraone

# ── LLM (OpenAI-compatible) ───────────────────────────────────────────────────
# Works with OpenAI, Azure OpenAI, Ollama, vLLM, Groq, Together, OpenRouter,
# DeepSeek, LM Studio, etc. — any provider that speaks the OpenAI Chat API.
#
# Examples:
#   OpenAI:     LLM_BASE_URL=https://api.openai.com/v1   LLM_MODEL=gpt-4o
#   Ollama:     LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=llama3.1
#   Groq:       LLM_BASE_URL=https://api.groq.com/openai LLM_MODEL=llama-3.3-70b-versatile
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1 LLM_MODEL=anthropic/claude-3.5-sonnet
#   DeepSeek:   LLM_BASE_URL=https://api.deepseek.com   LLM_MODEL=deepseek-chat

LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=150

# Optional: separate models for analytics/training (defaults to LLM_MODEL)
# ANALYTICS_LLM_MODEL=gpt-4o-mini
# TRAINING_LLM_MODEL=gpt-4o

# ── Deepgram (speech-to-text) ──────────────────────────────────────────────────
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_MODEL=nova-3-general

# ── Twilio (phone system) ──────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── ElevenLabs (TTS) ───────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE=pNInz6obpgDQGcFmaJgB

# ── Sarvam AI (TTS for Indian languages) ──────────────────────────────────────
SARVAM_API_KEY=your_sarvam_api_key_here

# ── Cloudflare Tunnel (replaces ngrok) ────────────────────────────────────────
# Quick tunnel (no account needed): leave TUNNEL_TOKEN empty, a temporary
#   trycloudflare.com URL is generated automatically.
# Named tunnel (recommended): set TUNNEL_TOKEN from your Cloudflare dashboard.
# Pre-known hostname: set TUNNEL_URL to skip auto-discovery.
TUNNEL_TOKEN=
TUNNEL_URL=

# ── Audio ──────────────────────────────────────────────────────────────────────
AUDIO_RATE=16000
RECORDINGS_DIR=recordings

# ════════════════════════════════════════════════════════════════════════════
# Frontend variables (Vite reads these — must be prefixed with VITE_)
# ════════════════════════════════════════════════════════════════════════════
VITE_API_URL=http://localhost:8000
VITE_MAPBOX_TOKEN=

# ── Frontend AI (insights extraction, protocol questions) ────────────────────
# The frontend makes its own AI calls for real-time insights extraction.
# Set VITE_TRAINING_AI_PROVIDER to "openai" to use an OpenAI-compatible
# endpoint, or "google" for Google Gemini.
VITE_TRAINING_AI_PROVIDER=openai
VITE_GOOGLE_API_KEY=
VITE_TRAINING_GOOGLE_MODEL=gemini-2.5-flash
VITE_OPENAI_API_KEY=
VITE_OPENAI_BASE_URL=https://api.openai.com/v1
VITE_TRAINING_OPENAI_MODEL=gpt-4o

# ── Frontend translation ─────────────────────────────────────────────────────
VITE_GOOGLE_TRANSLATE_API_KEY=

# ── Frontend ElevenLabs ──────────────────────────────────────────────────────
VITE_ELEVENLABS_API_KEY=
VITE_ELEVENLABS_API_URL=https://api.elevenlabs.io/v1

# ── Frontend Twilio ───────────────────────────────────────────────────────────
VITE_TWILIO_ACCOUNT_SID=
VITE_TWILIO_AUTH_TOKEN=
VITE_TWILIO_PHONE_NUMBER=

# ── OpenTelemetry & SigNoz Observability ────────────────────────────────────
# Enable or disable OpenTelemetry tracing, metrics, and logs (true/false)
OTEL_ENABLED=false
# Name of the backend service in SigNoz
OTEL_SERVICE_NAME=rudraone-backend
# Target OTLP endpoint (use host.docker.internal:4317 to connect from container to host machine SigNoz collector)
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4317
# OTLP exporter protocol: 'grpc' or 'http/protobuf'
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# SigNoz Cloud ingestion token (leave blank for local self-hosted SigNoz)
SIGNOZ_ACCESS_TOKEN=

# Frontend OpenTelemetry Configuration
VITE_OTEL_ENABLED=false
VITE_OTEL_SERVICE_NAME=rudraone-frontend
# HTTP OTLP endpoint (must be HTTP/Protobuf for web browsers)
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

